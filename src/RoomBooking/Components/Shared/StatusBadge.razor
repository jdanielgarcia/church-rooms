@{
    var css = Status switch
    {
        BookingStatus.Pending => "bg-amber-100 text-amber-800",
        BookingStatus.Approved => "bg-emerald-100 text-emerald-800",
        BookingStatus.Rejected => "bg-red-100 text-red-800",
        _ => "bg-slate-100 text-slate-700",
    };
}
<span class="@css rounded-full px-2 py-0.5 text-xs font-semibold">@Status</span>

@code {
    [Parameter] public BookingStatus Status { get; set; }
}
