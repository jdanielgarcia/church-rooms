@inject ChurchClock Clock

<div class="flex items-start justify-between gap-2">
    <div>
        <p class="font-semibold">@Booking.GroupName</p>
        <p class="text-sm text-slate-700">@Booking.Room.Name · @Clock.Describe(Booking)</p>
        @if (Booking.ReplacesBookingId is not null && Booking.Status == BookingStatus.Pending)
        {
            <p class="text-xs text-slate-500">Change request for booking #@Booking.ReplacesBookingId</p>
        }
    </div>
    <StatusBadge Status="Booking.Status" />
</div>
@if (!string.IsNullOrEmpty(Booking.RejectReason))
{
    <p class="mt-2 text-sm text-red-700">Reason: @Booking.RejectReason</p>
}
@if (!string.IsNullOrEmpty(Booking.AdminNote))
{
    <p class="mt-2 text-sm text-slate-600">@Booking.AdminNote</p>
}

@code {
    [Parameter, EditorRequired] public Booking Booking { get; set; } = default!;
}
