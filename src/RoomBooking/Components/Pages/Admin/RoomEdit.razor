@page "/admin/rooms/new"
@page "/admin/rooms/{Id:int}/edit"
@using System.ComponentModel.DataAnnotations
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject IdentityRedirectManager RedirectManager

<PageTitle>@(Id is null ? "Add room" : "Edit room")</PageTitle>

<a href="admin/rooms" class="link text-sm">← Rooms</a>
<h1 class="mb-4 mt-2 text-2xl font-bold">@(Id is null ? "Add room" : "Edit room")</h1>

<EditForm Model="Input" method="post" OnValidSubmit="Save" FormName="room" class="card max-w-lg space-y-4">
    <DataAnnotationsValidator />
    <ValidationSummary class="validation-errors" />
    <div>
        <label for="name" class="label">Name</label>
        <InputText @bind-Value="Input.Name" id="name" class="field" placeholder="e.g. Room 201" />
    </div>
    <div>
        <label for="desc" class="label">Description <span class="font-normal text-slate-500">(optional)</span></label>
        <InputTextArea @bind-Value="Input.Description" id="desc" rows="2" class="field" placeholder="Floor, chairs, aircon…" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</EditForm>

@code {
    [Parameter] public int? Id { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // A separate form model, so a crafted POST can't set Id or IsActive (over-posting).
    [SupplyParameterFromForm] private RoomForm Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        if (Input is not null)
            return;

        Input = new RoomForm();
        if (Id is int id)
        {
            var room = await Db.Rooms.FindAsync(id);
            if (room is null)
            {
                Nav.NotFound();
                return;
            }
            Input.Name = room.Name;
            Input.Description = room.Description;
        }
    }

    private async Task Save()
    {
        var room = Id is int id ? await Db.Rooms.FindAsync(id) : null;
        if (room is null)
        {
            room = new Room();
            Db.Rooms.Add(room);
        }
        room.Name = Input.Name.Trim();
        room.Description = string.IsNullOrWhiteSpace(Input.Description) ? null : Input.Description.Trim();
        await Db.SaveChangesAsync();
        RedirectManager.RedirectToWithStatus("admin/rooms", $"{room.Name} saved.", HttpContext);
    }

    private sealed class RoomForm
    {
        [Required, MaxLength(100)]
        public string Name { get; set; } = "";

        [MaxLength(500)]
        public string? Description { get; set; }
    }
}
